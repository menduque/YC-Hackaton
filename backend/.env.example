# Copy to .env and fill as keys arrive. See ../SETUP.md.
# The server boots even if these are empty and logs what's missing.

# --- server ---
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# --- 1. Deepgram (voice agent) ---
DEEPGRAM_API_KEY=

# --- 2. MedPlum (FHIR) ---
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
MEDPLUM_PROJECT_ID=

# --- 3. Stedi (eligibility 270/271) ---
STEDI_API_KEY=
STEDI_TEST_PAYER_ID=

# --- 4. Moss (RAG) ---
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# --- LLM for extraction / plan / peer-review (Claude) ---
ANTHROPIC_API_KEY=
