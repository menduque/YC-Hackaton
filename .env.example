# --- Deepgram (bloquea el paso 4: la conversación por voz) -------------------
DEEPGRAM_API_KEY=

# Modelo de LLM que "piensa" dentro del Voice Agent.
# Ver src/voice/agent.ts: el provider se elige acá para poder probar alternativas
# sin tocar código.
DG_THINK_PROVIDER=open_ai
DG_THINK_MODEL=gpt-4o-mini

# STT y TTS. antonia es la única voz es-AR del catálogo de Aura-2; el fallback
# latinoamericano genérico es aura-2-selena-es (es-419).
DG_LISTEN_MODEL=nova-3
DG_LISTEN_LANGUAGE=es
DG_SPEAK_MODEL=aura-2-antonia-es

# --- Servidor ----------------------------------------------------------------
PORT=8787

# --- Vendors del pase siguiente (hoy corren en mock determinístico) ----------
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
STEDI_API_KEY=
MEDPLUM_BASE_URL=https://api.medplum.com
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
MEDPLUM_PROJECT_ID=
