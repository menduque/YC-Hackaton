# Copy to `.env` (gitignored). Server-side only — never expose to the browser bundle.
# The backend reads these via backend/src/config.ts; scripts/ and the Vite dev
# middleware read the same file.

# --- Deepgram (blocks the voice conversation) --------------------------------
DEEPGRAM_API_KEY=

# LLM that "thinks" inside the Voice Agent. Chosen here so alternatives can be
# tried without touching code (see backend/src/deepgram/agentConfig.ts).
DG_THINK_PROVIDER=open_ai
DG_THINK_MODEL=gpt-4o-mini

# STT and TTS. antonia is the only es-AR voice in the Aura-2 catalogue; the
# generic Latin-American fallback is aura-2-selena-es (es-419).
DG_LISTEN_MODEL=nova-3
DG_LISTEN_LANGUAGE=es
DG_SPEAK_MODEL=aura-2-antonia-es

# --- Server ------------------------------------------------------------------
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# --- Stedi — eligibility 270/271 (TEST MODE ONLY) ----------------------------
# Generate a TEST key at https://portal.stedi.com/app/settings/developer/api-keys
# (Mode: Test). Test keys only work with the documented mock requests — no
# PHI/PII, nothing reaches a real payer, no charges. The backend refuses to run
# with a key that doesn't start with `test_`.
STEDI_API_KEY=
STEDI_ACCOUNT_ID=
# Which mock fixture an unmapped payer name falls back to.
# Any id from app/src/stedi/mock-requests.ts — see `npm run stedi -- --list`.
STEDI_TEST_PAYER_ID=aetna

# --- Moss (moss.dev) ---------------------------------------------------------
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# --- Medplum (hosted cloud) --------------------------------------------------
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_PROJECT_ID=
# Only needed for headless (client-credentials) auth from the backend.
# Create one at app.medplum.com > Admin > Project > Clients.
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# --- Anthropic (optional — grounding investigar_problema) --------------------
ANTHROPIC_API_KEY=
