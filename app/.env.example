# Copy to `app/.env`. Everything here is VITE_-prefixed and therefore PUBLIC —
# it ends up in the browser bundle. Secrets belong in the repo-root `.env`.

# Medplum hosted cloud (https://app.medplum.com) — sign up for a free project,
# then fill these in. Client ID comes from Project > Clients (create a "SPA" client
# with this app's dev URL, e.g. http://localhost:5173, as an allowed redirect URI).
VITE_MEDPLUM_BASE_URL=https://api.medplum.com/
VITE_MEDPLUM_CLIENT_ID=
VITE_MEDPLUM_PROJECT_ID=

# Moss (https://moss.dev). The Moss project key is designed for client-side use.
VITE_MOSS_PROJECT_ID=
VITE_MOSS_PROJECT_KEY=
